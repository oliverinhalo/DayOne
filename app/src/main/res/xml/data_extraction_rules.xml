<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: the same content for cloud backup and for a direct device-to-device
  transfer. Exported videos are left out - they are large and reproducible.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="DayOne/" />
        <exclude domain="external" path="DayOne/exports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="DayOne/" />
        <exclude domain="external" path="DayOne/exports/" />
    </device-transfer>
</data-extraction-rules>
